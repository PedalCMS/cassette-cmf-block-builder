{
    "blocks": [
        {
            "id": "acme-e2e/callout",
            "args": {
                "title": "E2E Callout",
                "category": "text",
                "icon": "megaphone"
            },
            "fields": [
                {
                    "name": "is_dismissible",
                    "type": "toolbar_toggle",
                    "area": "toolbar",
                    "label": "Dismissible",
                    "icon": "no"
                },
                {
                    "name": "settings",
                    "type": "panel",
                    "title": "Callout settings",
                    "initial_open": true,
                    "fields": [
                        {
                            "name": "heading",
                            "type": "text",
                            "label": "Heading"
                        },
                        {
                            "name": "dismiss_label",
                            "type": "text",
                            "label": "Dismiss button label",
                            "conditional": {
                                "rules": [
                                    {
                                        "field": "is_dismissible",
                                        "operator": "==",
                                        "value": true
                                    }
                                ]
                            }
                        }
                    ]
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-callout",
                    "children": [
                        {
                            "tag": "strong",
                            "class": "acme-e2e-callout__heading",
                            "text": "{{ attributes.heading }}"
                        },
                        {
                            "tag": "button",
                            "class": "acme-e2e-callout__dismiss",
                            "text": "{{ attributes.dismiss_label }}",
                            "when": {
                                "rules": [
                                    {
                                        "field": "is_dismissible",
                                        "operator": "==",
                                        "value": true
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": "acme-e2e/container",
            "args": {
                "title": "E2E Container",
                "category": "text",
                "icon": "layout"
            },
            "inner_blocks": {
                "allowed": [
                    "core/paragraph",
                    "core/heading"
                ],
                "template": [
                    [
                        "core/paragraph",
                        {
                            "placeholder": "Container content..."
                        }
                    ]
                ]
            },
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-container",
                    "slot": "inner_blocks"
                }
            }
        },
        {
            "id": "acme-e2e/child",
            "args": {
                "title": "E2E Child",
                "category": "text",
                "icon": "admin-page",
                "parent": [
                    "acme-e2e/container"
                ]
            },
            "fields": [
                {
                    "name": "label",
                    "type": "text",
                    "label": "Label"
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "span",
                    "text": "{{ attributes.label }}"
                }
            }
        },
        {
            "id": "acme-e2e/quote",
            "args": {
                "title": "E2E Quote",
                "category": "text",
                "icon": "format-quote"
            },
            "fields": [
                {
                    "name": "quote_text",
                    "type": "textarea",
                    "label": "Quote"
                },
                {
                    "name": "cite",
                    "type": "text",
                    "label": "Attribution"
                }
            ],
            "render": {
                "mode": "static",
                "markup": {
                    "tag": "blockquote",
                    "class": "acme-e2e-quote",
                    "children": [
                        {
                            "tag": "p",
                            "text": "{{ attributes.quote_text }}"
                        },
                        {
                            "tag": "cite",
                            "text": "{{ attributes.cite }}",
                            "when": {
                                "rules": [
                                    {
                                        "field": "cite",
                                        "operator": "not_empty"
                                    }
                                ]
                            }
                        }
                    ]
                },
                "deprecated": [
                    {
                        "markup": {
                            "tag": "blockquote",
                            "class": "acme-e2e-quote-v1",
                            "text": "{{ attributes.quote_text }}"
                        }
                    }
                ]
            }
        },
        {
            "id": "acme-e2e/server-preview",
            "args": {
                "title": "E2E Server Preview",
                "category": "text",
                "icon": "clock"
            },
            "fields": [
                {
                    "name": "note",
                    "type": "text",
                    "label": "Note"
                }
            ],
            "preview": {
                "mode": "server"
            },
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-server-preview",
                    "text": "{{ attributes.note }}"
                }
            }
        },
        {
            "id": "acme-e2e/document-panel",
            "args": {
                "title": "E2E Document Panel"
            },
            "document_scope": {
                "post_types": [
                    "post"
                ],
                "when_present": true
            },
            "fields": [
                {
                    "name": "internal_note",
                    "type": "text",
                    "area": "sidebar",
                    "label": "Internal note",
                    "source": "meta",
                    "meta": {
                        "key": "acme_e2e_internal_note"
                    }
                }
            ]
        },
        {
            "id": "acme-e2e/uuid-item",
            "args": {
                "title": "E2E Uuid Item",
                "category": "text",
                "icon": "id"
            },
            "fields": [
                {
                    "name": "instance_id",
                    "type": "uuid"
                },
                {
                    "name": "label",
                    "type": "text",
                    "label": "Label"
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-uuid-item",
                    "attrs": {
                        "data-instance-id": "{{ attributes.instance_id }}"
                    },
                    "text": "{{ attributes.label }}"
                }
            }
        },
        {
            "id": "acme-e2e/form",
            "args": {
                "title": "E2E Form",
                "category": "text",
                "icon": "forms",
                "providesContext": {
                    "acme-e2e/formId": "form_id"
                }
            },
            "inner_blocks": {
                "allowed": [
                    "acme-e2e/form-field",
                    "core/group",
                    "core/columns"
                ]
            },
            "fields": [
                {
                    "name": "form_id",
                    "type": "text",
                    "label": "Form ID"
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-form",
                    "slot": "inner_blocks"
                }
            }
        },
        {
            "id": "acme-e2e/form-field",
            "args": {
                "title": "E2E Form Field",
                "category": "text",
                "icon": "edit",
                "ancestor": [
                    "acme-e2e/form"
                ]
            },
            "fields": [
                {
                    "name": "field_id",
                    "type": "uuid"
                },
                {
                    "name": "form_id",
                    "type": "text",
                    "source": "context",
                    "context": "acme-e2e/formId"
                },
                {
                    "name": "name",
                    "type": "text",
                    "label": "Field name",
                    "format": "slug",
                    "unique": {
                        "scope": "ancestor",
                        "block": "acme-e2e/form",
                        "key": "fieldName"
                    }
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-form-field",
                    "attrs": {
                        "data-field-id": "{{ attributes.field_id }}"
                    },
                    "children": [
                        {
                            "tag": "span",
                            "class": "acme-e2e-form-field__form-id",
                            "text": "{{ attributes.form_id }}"
                        },
                        {
                            "tag": "span",
                            "class": "acme-e2e-form-field__name",
                            "text": "{{ attributes.name }}"
                        }
                    ]
                }
            }
        },
        {
            "id": "acme-e2e/form-rule",
            "args": {
                "title": "E2E Form Rule",
                "category": "text",
                "icon": "filter",
                "ancestor": [
                    "acme-e2e/form"
                ]
            },
            "fields": [
                {
                    "name": "name",
                    "type": "text",
                    "label": "Rule name"
                },
                {
                    "name": "target",
                    "type": "ancestor_field",
                    "label": "Target field",
                    "ancestor": "acme-e2e/form",
                    "blocks": [
                        "acme-e2e/form-field"
                    ],
                    "has_attribute": "name"
                },
                {
                    "name": "show_when",
                    "type": "conditions",
                    "label": "Show when",
                    "conditions": {
                        "ancestor": "acme-e2e/form",
                        "blocks": [
                            "acme-e2e/form-field"
                        ]
                    }
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-form-rule",
                    "children": [
                        {
                            "tag": "span",
                            "text": "{{ attributes.target }}"
                        }
                    ]
                }
            }
        },
        {
            "id": "acme-e2e/embed",
            "args": {
                "title": "E2E Embed",
                "category": "text",
                "icon": "embed-generic"
            },
            "fields": [
                {
                    "name": "url",
                    "type": "url",
                    "label": "Address",
                    "area": "placeholder",
                    "required": true
                },
                {
                    "name": "caption",
                    "type": "text",
                    "label": "Caption"
                }
            ],
            "placeholder": {
                "label": "E2E Embed",
                "instructions": "Paste an address to embed."
            },
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "figure",
                    "class": "acme-e2e-embed",
                    "children": [
                        {
                            "tag": "a",
                            "attrs": {
                                "href": "{{ attributes.url }}"
                            },
                            "text": "{{ attributes.url }}"
                        }
                    ]
                }
            }
        },
        {
            "id": "acme-e2e/columns",
            "args": {
                "title": "E2E Columns",
                "category": "text",
                "icon": "columns",
                "variations": [
                    {
                        "name": "two",
                        "title": "Two columns",
                        "scope": [
                            "block"
                        ],
                        "attributes": {
                            "count": 2
                        },
                        "innerBlocks": [
                            [
                                "core/paragraph",
                                {
                                    "content": "One"
                                }
                            ],
                            [
                                "core/paragraph",
                                {
                                    "content": "Two"
                                }
                            ]
                        ]
                    },
                    {
                        "name": "three",
                        "title": "Three columns",
                        "scope": [
                            "block"
                        ],
                        "attributes": {
                            "count": 3
                        },
                        "innerBlocks": [
                            [
                                "core/paragraph",
                                {
                                    "content": "One"
                                }
                            ],
                            [
                                "core/paragraph",
                                {
                                    "content": "Two"
                                }
                            ],
                            [
                                "core/paragraph",
                                {
                                    "content": "Three"
                                }
                            ]
                        ]
                    }
                ]
            },
            "fields": [
                {
                    "name": "count",
                    "type": "number",
                    "label": "Columns",
                    "default": 1
                }
            ],
            "inner_blocks": {
                "enabled": true
            },
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-columns",
                    "children": [
                        {
                            "slot": "inner_blocks"
                        }
                    ]
                }
            }
        },
        {
            "id": "acme-e2e/legacy-note",
            "args": {
                "title": "E2E Legacy Note",
                "category": "text",
                "icon": "edit"
            },
            "fields": [
                {
                    "name": "heading",
                    "type": "text",
                    "label": "Heading"
                },
                {
                    "name": "tone",
                    "type": "select",
                    "label": "Tone",
                    "options": {
                        "warm": "Warm",
                        "cool": "Cool"
                    }
                }
            ],
            "render": {
                "mode": "dynamic",
                "markup": {
                    "tag": "div",
                    "class": "acme-e2e-note acme-e2e-note--{{ attributes.tone }}",
                    "children": [
                        {
                            "tag": "h3",
                            "text": "{{ attributes.heading }}"
                        }
                    ]
                },
                "deprecated": [
                    {
                        "attributes": {
                            "title": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string"
                            }
                        },
                        "migrate": {
                            "rename": {
                                "title": "heading",
                                "kind": "tone"
                            },
                            "map": {
                                "tone": {
                                    "hot": "warm",
                                    "cold": "cool"
                                }
                            }
                        }
                    }
                ]
            }
        }
    ]
}
