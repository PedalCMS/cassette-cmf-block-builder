{
  "description": "Shared by tests/js/unique.test.js (find-collisions.js) and tests/Unit/Test_Unique_Checker.php (Render\\Unique_Checker). Blocks use the parse_blocks() shape; paths are index paths from the root.",
  "cases": [
    {
      "name": "whole post: duplicates at the top level",
      "rule": {
        "scope": "post"
      },
      "participants": {
        "vendor/field": {
          "attribute": "name"
        },
        "vendor/other-field": {
          "attribute": "slug",
          "format": "slug"
        }
      },
      "blocks": [
        {
          "blockName": "vendor/field",
          "attrs": {
            "name": "a"
          },
          "innerBlocks": []
        },
        {
          "blockName": "vendor/field",
          "attrs": {
            "name": "b"
          },
          "innerBlocks": []
        },
        {
          "blockName": "vendor/field",
          "attrs": {
            "name": "a"
          },
          "innerBlocks": []
        }
      ],
      "expected": [
        {
          "value": "a",
          "paths": [
            [
              0
            ],
            [
              2
            ]
          ]
        }
      ]
    },
