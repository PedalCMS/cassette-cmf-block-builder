{
	"name": "cassette-cmf-block-builder",
	"description": "Declarative Gutenberg blocks for Cassette-CMF",
	"version": "0.0.1",
	"private": true,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=src/assets/src --output-path=src/assets/build",
		"start": "wp-scripts start --webpack-src-dir=src/assets/src --output-path=src/assets/build",
		"lint:js": "wp-scripts lint-js src/assets/src",
		"format": "wp-scripts format src/assets/src",
		"test:unit:js": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-playwright",
		"env": "wp-env"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@wordpress/e2e-test-utils-playwright": "^1.30.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/scripts": "^30.24.0",
		"typescript": "5.3.3"
	}
}
