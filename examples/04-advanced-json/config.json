        {
            "id": "cassette-cmf-forms/field-select",
            "args": {
                "title": "Select",
                "category": "cassette-cmf-forms",
                "icon": "menu"
            },
            "fields": [
                {
                    "name": "settings",
                    "type": "panel",
                    "title": "Select Field",
                    "initial_open": true,
                    "fields": [
                        {
                            "name": "label",
