                            "default": "select_field",
                            "derive_from": "label",
                            "format": "slug"
                        },
                        {
                            "name": "options",
                            "type": "options_list",
                            "label": "Options",
                            "default": [
                                { "value": "option_1", "label": "Option 1" },
                                { "value": "option_2", "label": "Option 2" }
                            ]
                        },
                        {
                            "name": "help_text",
                            "type": "textarea",
                            "label": "Help text"
                        },
                        {
                            "name": "required",
                            "type": "toggle",
                            "label": "Required",
                            "default": false
                        }
                    ]
                }
            ],
            "render": {
                "markup": {
                    "tag": "div",
                    "class": "cassette-cmf-block-builder-field-preview",
                    "children": [
                        {
                            "tag": "div",
                            "class": "cassette-cmf-block-builder-field-preview__label-row",
                            "children": [
                                { "tag": "strong", "text": "{{ attributes.label }}" },
