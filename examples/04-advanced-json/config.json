                                    "class": "cassette-cmf-block-builder-field-preview__badge",
                                    "text": "Checkbox"
                                }
                            ]
                        },
                        {
                            "tag": "label",
                            "class": "cassette-cmf-block-builder-field-preview__checkbox-label",
                            "children": [
                                {
                                    "tag": "input",
                                    "attrs": { "type": "checkbox", "disabled": "disabled" }
                                },
                                {
                                    "tag": "span",
                                    "text": "{{ attributes.checkbox_label }}"
