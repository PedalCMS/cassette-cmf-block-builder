        {
            "id": "cassette-cmf-forms/field-checkbox",
            "args": {
                "title": "Checkbox",
                "category": "cassette-cmf-forms",
                "icon": "yes-alt"
            },
            "fields": [
                {
                    "name": "settings",
                    "type": "panel",
                    "title": "Checkbox Field",
                    "initial_open": true,
                    "fields": [
