# Distribution Ignore File
# Files and directories listed here are excluded from release packages.
# The release workflow (.github/workflows/release.yml) reads this file with rsync --exclude-from,
# so this list decides what the release archive leaves out.

# Development
.git/
.github/
.cache/
.editorconfig
.gitignore
.gitattributes
.distignore

# JS source (build output in src/assets/build/ IS shipped)
src/assets/src/
node_modules/
package.json
package-lock.json
webpack.config.js
.wp-env.json
playwright.config.js

# Testing
tests/
bin/
phpunit.xml.dist
phpunit.xml

# Code Quality
phpcs.xml.dist
phpcs.xml
.phpcs.xml
phpstan.neon.dist
phpstan.neon
.phpstan.neon

# Composer Dev
composer.lock

# Examples / docs (available in repository)
examples/
docs/

# Schemas and tooling configuration
block-schema.json
jest.config.js

# Test output
artifacts/
coverage/
.phpunit.result.cache

# IDE
.idea/
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db
